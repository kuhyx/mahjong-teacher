{
  "name": "mahjong-teacher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/agent_artifacts.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && bash scripts/check_determinism.sh",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "bridge": "node services/bridge/main.ts",
    "relay": "node services/relay/main.ts",
    "tutorial-brief": "node scripts/tutorial_brief.ts",
    "e2e": "node scripts/e2e_done_check.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "fast-check": "4.10.3",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "firebase": "13.4.0"
  }
}
